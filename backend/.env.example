# ─────────────────────────────────────────────
# Swiggy LifeOS Backend — Environment Variables
# ─────────────────────────────────────────────
# IMPORTANT: Swiggy MCP uses OAuth 2.1 + PKCE.
# There is NO static API key.
# The access token is generated automatically after the user completes
# Phone + OTP login at the Swiggy OAuth authorize URL.
#
# HOW TO GET THE TOKEN:
#   1. Start backend: python main.py
#   2. Open: http://localhost:8000/api/auth/start
#   3. Copy the authorize_url and open it in your browser
#   4. Complete Swiggy Phone + OTP login
#   5. Swiggy redirects to http://localhost:8000/api/auth/callback
#   6. Token is saved to SWIGGY_ACCESS_TOKEN below automatically
#   7. Test with: http://localhost:8000/api/auth/first-tool-test
# ─────────────────────────────────────────────

# Anthropic Claude API Key (for real AI backend)
# Get from: https://console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=your_anthropic_key_here

# Swiggy OAuth Access Token — SET AUTOMATICALLY after OAuth login
# Do NOT set this manually. It is written here after /api/auth/callback succeeds.
# Token expires in 5 days. Re-run OAuth flow to refresh.
SWIGGY_ACCESS_TOKEN=

# OAuth callback URL (must match redirect_uri used in /api/auth/start)
# For local dev: http://localhost:8000/api/auth/callback
# For production: https://your-backend.com/api/auth/callback
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Swiggy Official MCP Server URLs (do not change)
SWIGGY_FOOD_MCP_URL=https://mcp.swiggy.com/food
SWIGGY_IM_MCP_URL=https://mcp.swiggy.com/im
SWIGGY_DINEOUT_MCP_URL=https://mcp.swiggy.com/dineout

# Frontend URL (for OAuth redirect after callback)
FRONTEND_URL=http://localhost:5173
